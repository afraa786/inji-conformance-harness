# Harness inputs, not additional image environment variables.
# Verified upstream alpha releases; not stable GA 1.0.0 images.
CERTIFY_TAG=1.0.0-alpha.1
VERIFY_TAG=1.0.0-alpha.1
SUITE_IMAGE=registry.gitlab.com/openid/conformance-suite@sha256:dcc4bd1fb7e9c00f048a67373fe2bec5ecf9feb45a6b5d55e237e5c30e5312c6
SUITE_FRONTEND_IMAGE=registry.gitlab.com/openid/conformance-suite/nginx@sha256:9a7850826fcc8690cd43373528f50e9551ba33bf8e4a40b67b13267b0aca3675
POSTGRES_TAG=15
MONGODB_TAG=6.0.13
POSTGRES_PASSWORD=DEV_ONLY_CHANGE_ME
VERIFY_KEYSTORE_PASSWORD=DEV_ONLY_CHANGE_ME
CERTIFY_KEYSTORE_PASSWORD=DEV_ONLY_CHANGE_ME
SUITE_GOOGLE_SECRET=DEV_ONLY_CHANGE_ME
SUITE_GITLAB_SECRET=DEV_ONLY_CHANGE_ME
DB_INIT_DIR=./local/db-init
CERTIFY_CONFIG_DIR=./local/certify-config
OIDC_SUITE_INSECURE=false
REQUESTS_CA_BUNDLE=./local/tls/ca.crt
SUITE_URL=https://localhost:8443
SUITE_PUBLIC_URL=https://suite.test:8443
# Plan targets are reachable by the suite; API URLs are reachable by host Python.
CERTIFY_TARGET=https://certify.test:8446
VERIFY_TARGET=https://verify.test:8447/v1/verify
CERTIFY_API_URL=https://localhost:8446/v1/certify
VERIFY_API_URL=https://localhost:8447/v1/verify
CLIENT_ID=DEV_ONLY_SUITE_CLIENT
CLIENT2_ID=DEV_ONLY_SUITE_CLIENT_2
CERTIFY_TX_CODE=TEST1234
CREDENTIAL_CONFIGURATION_ID=HarnessSdJwtCredential
CERTIFY_CLAIMS_JSON_FILE=./local/claims.json
VERIFIER_CLIENT_ID=redirect_uri:https://verify.test:8447/v1/verify/v2/vp-submission/direct-post
VERIFY_REQUEST_JSON_FILE=./local/verify-request.json
VERIFIER_SIGNING_JWK_JSON_FILE=./local/verifier-signing-jwk.json
